  "PrimaryDesign": {
    "InputContract": "same-city Sao Paulo Olist order-time proxy + lead-specific GFS forecast + ERA5 actual wind; external M100 energy envelope",
    "Replications": 60,
    "SharedRandomNumbers": true,
    "PolicySet": [
      "AlwaysFixed",
      "ETFixed",
      "AlwaysAdaptive",
      "ETAdaptive",
      "AlwaysMyopic reference"
    ],
    "PrimaryContrast": "ETFixed minus AlwaysFixed",
    "PrimaryStatisticalAnalysis": "Scenario-level paired Student-t 95% confidence interval",
    "Diagnostics": [
      "paired percentile-bootstrap 95% CI",
      "exploratory order-level mixed-effects logistic diagnostic with scenario random intercept only"
    ],
    "SafetyInvariant": "UnsafeExecutionRate is zero in every guarded replication"
  },
  "SupplementaryDesign": {
    "ReplicationsPerCondition": 20,
    "Conditions": [
      "P80 weather gate",
      "wind-gate ablation",
      "low-SoC-gate ablation",
      "three inertia ranges",
      "two PlanChangeScale conditions",
      "H=2/3/4 windows",
      "paired guard ON/OFF"
    ],
    "AdditionalR60Conditions": [
      "D=2/3/4 fleet-size boundary under the primary fixed-inertia comparison",
      "outcome-blind descriptive input strata of 30 lower and 30 upper primary scenarios"
    ],
    "Interpretation": "Supplementary conditions are mechanism or boundary evidence and do not reselect the primary policy."
  },
  "ClaimBoundaries": [
    "Same-city inputs improve joint demand-weather credibility but are not an enterprise deployment log.",
    "Olist purchase timestamps are demand-timing proxies, not last-mile order-release timestamps.",
    "Spatial zones are calibration-only abstract proxies; platform position and movement remain engineering assumptions.",
    "M100 energy data are an external aircraft-transfer envelope, not same-city target-aircraft telemetry.",
    "VIP labels, W3, and Hs are scenario/governance parameters, not empirical organisational-cost estimates.",
    "The fleet-size exercise tests robustness of the fixed-inertia governance contrast, not a monotonic fleet-sizing rule.",
    "The input strata are outcome-blind descriptive analyses, not prespecified confirmatory moderator tests.",
    "The order-level mixed-effects diagnostic represents scenario clustering but not order-level policy pairing; its Wald intervals are descriptive and cannot replace scenario-level paired inference.",
    "Do not claim an adaptive-inertia advantage over ETFixed: the tested sensitivity ranges do not establish one.",
    "Do not claim the ETFixed VIP difference is Student-t confirmed: its primary t interval marginally crosses zero, although the paired bootstrap interval is positive."
  ],
